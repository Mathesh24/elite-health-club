# Copy to .env.local for local development (`npx netlify dev`).
# In Netlify, set these under Site configuration -> Environment variables,
# scoped per deploy context (sandbox values for previews, live for production).
# Never commit real values.

# Apps Script URL is configured in src/lib/google-sheets.ts.

# Show the checkout buttons in this build (netlify.toml sets it per context)
NEXT_PUBLIC_PAYMENTS_ENABLED=true

# --- Server-only: payment functions ---
PAYMENTS_ENABLED=true
ZOHO_PAY_ENV=sandbox                 # sandbox | live
ZOHO_PAY_ACCOUNT_ID=
ZOHO_PAY_WIDGET_API_KEY=             # public widget key from Developer Space
ZOHO_OAUTH_CLIENT_ID=                # secret
ZOHO_OAUTH_CLIENT_SECRET=            # secret
ZOHO_OAUTH_REFRESH_TOKEN=            # secret, from scripts/zoho-oauth.mjs
ZOHO_PAY_WEBHOOK_SIGNING_KEY=        # secret, shown once when the webhook is created
PAYMENTS_SHEET_SECRET=               # secret, must match Script Property PAYMENTS_SECRET
